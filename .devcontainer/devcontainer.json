{
  "name": "NEXUS V2 Development",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "remoteUser": "vscode",
  "containerEnv": {
    "NEXUS_ENV": "development",
    "NEXUS_LIVE_AUTHORITY": "disabled"
  },
  "postCreateCommand": "python infra/github/repo_baseline_check.py && python scripts/dev_check.py",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true
      }
    }
  }
}
